generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AlbumCategory {
  Faith
  Campus
  Academics
  Sports
  Arts
}

enum AlbumStatus {
  Published
  Review
  Archived
}

enum InboxStatus {
  new
  read
  handled
}

/// An album event. Photos and highlights are always read and replaced as a
/// whole, so they live in JSONB on the row: one read, one atomic write.
model Album {
  id          String        @id @db.VarChar(32)
  title       String        @db.VarChar(160)
  category    AlbumCategory
  status      AlbumStatus   @default(Review)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  eventDate   DateTime      @map("event_date") @db.Date
  location    String        @default("") @db.VarChar(160)
  description String        @default("") @db.VarChar(5000)
  coverSrc    String?       @map("cover_src")
  /// AlbumHighlight[]
  highlights  Json          @default("[]") @db.JsonB
  /// AlbumPhoto[]
  photos      Json          @default("[]") @db.JsonB

  @@index([status, createdAt(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc)])
  @@map("albums")
}

model Inquiry {
  id         String      @id @db.VarChar(32)
  firstName  String      @map("first_name") @db.VarChar(80)
  lastName   String      @map("last_name") @db.VarChar(80)
  email      String      @db.VarChar(160)
  phone      String      @default("") @db.VarChar(40)
  gradeLevel String      @default("") @map("grade_level") @db.VarChar(80)
  message    String      @default("") @db.VarChar(2000)
  status     InboxStatus @default(new)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("inquiries")
}

model ContactMessage {
  id        String      @id @db.VarChar(32)
  fullName  String      @map("full_name") @db.VarChar(120)
  email     String      @db.VarChar(160)
  phone     String      @default("") @db.VarChar(40)
  subject   String      @default("") @db.VarChar(120)
  message   String      @db.VarChar(4000)
  status    InboxStatus @default(new)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("contact_messages")
}

model Faq {
  id       String @id @db.VarChar(32)
  question String @db.VarChar(240)
  answer   String @db.VarChar(2000)
  position Int

  @@index([position])
  @@map("faqs")
}

/// Single row (id = 1) holding the site's contact details.
model SiteSettings {
  id              Int    @id @default(1)
  phonePrimary    String @default("") @map("phone_primary") @db.VarChar(200)
  phoneSecondary  String @default("") @map("phone_secondary") @db.VarChar(200)
  emailGeneral    String @default("") @map("email_general") @db.VarChar(160)
  emailAdmissions String @default("") @map("email_admissions") @db.VarChar(160)
  addressLine1    String @default("") @map("address_line1") @db.VarChar(200)
  addressLine2    String @default("") @map("address_line2") @db.VarChar(200)
  officeHours     String @default("") @map("office_hours") @db.VarChar(200)
  mapUrl          String @default("") @map("map_url") @db.VarChar(500)
  /// { instagram, facebook, x, linkedin }
  socials         Json   @default("{}") @db.JsonB

  @@map("site_settings")
}

model Admin {
  id           String   @id @db.VarChar(32)
  username     String   @unique @db.VarChar(80)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("admins")
}
