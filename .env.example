# Postgres (matches docker-compose.yml for local development)
DATABASE_URL="postgresql://greengarden:greengarden@localhost:5432/greengarden"
# Max connections in the app's pool (default 10)
DATABASE_POOL_MAX=10

# Admin account, created / updated by `npm run db:seed` (keyphrase is stored hashed)
ADMIN_USERNAME="admin_root"
ADMIN_KEYPHRASE="change-me-to-a-long-passphrase"

# Cloudinary (album cover and photo uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder uploads go into (default greengarden/albums)
CLOUDINARY_FOLDER="greengarden/albums"

# Session JWT signing key (random, 32+ chars). Rotating it signs every admin out.
JWT_SECRET=""
